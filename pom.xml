<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.ifct0609</groupId>
    <artifactId>gestor-cine</artifactId>
    <version>1.0.0</version>
    <name>Gestor sencillo de películas</name>
    <description>Proyecto de examen IFCT0609 MF0965_3 con Java y H2</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- H2 es la base de datos que utiliza la aplicación. Maven la descarga automáticamente. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.5.252</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compila el proyecto con Java 17 o una versión posterior compatible. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>

            <!-- Permite ejecutar la aplicación con mvn exec:java. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>es.ifct0609.cine.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
